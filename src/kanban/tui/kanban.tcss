/* Styles for the kanban TUI.

   Colour carries meaning: the accent colour marks focus, amber (warning)
   marks a card staged for a move, and dim greys mark metadata. */

Screen {
    background: $background;
}

/* Vertical scrollbars default to two cells wide.  One reads just as well and
   hands the extra cell back to the cards. */
* {
    scrollbar-size-vertical: 1;
}

#board-body {
    height: 1fr;
}

/* ── Columns ──────────────────────────────────────────────────────────── */

#columns {
    height: 1fr;
    width: 1fr;
    overflow-x: auto;
    padding: 0 0 0 1;
}

/* Columns keep a fixed width so cards stay a consistent size; the container
   scrolls horizontally once the board outgrows the terminal.  The panel carries
   the border, so it wraps the header and the cards together. */
ColumnPanel {
    width: 34;
    height: 1fr;
    margin: 0 1 0 0;
    background: $surface;
    border: round $panel;
}

/* Focus is blue and a move is amber.  They have to be different hues: the
   theme resolves $accent and $warning to the same colour, and the staged
   column is always the focused one.  The header and the cards are separate
   focus targets within one column, so the border answers to either. */
ColumnPanel:focus-within {
    border: round $primary;
}

/* During a move only the column the card would land in is marked, so the eye
   follows the card across the board.  Written to beat the :focus rule above. */
ColumnPanel.-staging,
ColumnPanel:focus-within.-staging {
    border: dashed $warning;
}

ColumnView {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    background: transparent;
    border: none;
}

/* ── Column headers ───────────────────────────────────────────────────── */

/* One line, holding the label or — while a column is being named — the field
   that replaces it. */
ColumnHeader {
    width: 1fr;
    height: 1;
    align-horizontal: center;
    color: $text-muted;
    text-style: bold;
}

ColumnHeader > .-title {
    width: 1fr;
    height: 1;
    text-align: center;
}

ColumnPanel:focus-within > ColumnHeader {
    color: $primary;
}

ColumnPanel.-staging > ColumnHeader {
    color: $warning;
}

/* A focused header is inverted, the way a highlighted row is elsewhere: the
   panel's border says which column, this says which half of it.

   Both selectors are needed.  The rules above colour the header of a focused or
   staged column, and they are the more specific of the two, so an inverted
   header would keep their foreground and lose its text against the background
   this sets — the block cursor's colours only work as a pair. */
ColumnHeader:focus,
ColumnPanel:focus-within > ColumnHeader:focus,
ColumnPanel.-staging > ColumnHeader:focus {
    color: $block-cursor-foreground;
    background: $block-cursor-background;
    text-style: $block-cursor-text-style;
}

/* The name is typed where it is read: the field covers the label rather than
   sitting beside it, so the header stays one line either way.

   It is only as wide as what has been typed — plus the cell the cursor sits in
   — and the header centres it, so a name grows from the middle exactly where
   the label sat rather than jumping to the left edge to be edited.  No
   `min-width`: a floor would hold the text against the left of the field until
   it grew past it, which is the jump this avoids.  `max-width` hands a name too
   long for the column back to the field's own scrolling. */
ColumnHeader > .-name {
    display: none;
    width: auto;
    max-width: 100%;
    background: $boost;
}

ColumnHeader.-naming > .-title {
    display: none;
}

ColumnHeader.-naming > .-name {
    display: block;
}

ColumnView > ListItem {
    background: transparent;
    padding: 0;
    margin: 0 0 1 0;
}

ColumnView > ListItem.-highlight {
    background: transparent;
}

/* ── Cards ────────────────────────────────────────────────────────────── */

CardWidget {
    width: 1fr;
    height: auto;
    padding: 0 1;
    background: $surface;
    border: round $panel-lighten-1;
}

ColumnView > ListItem.-highlight CardWidget {
    border: round $primary-darken-2;
}

ColumnView:focus > ListItem.-highlight CardWidget {
    background: $boost;
    border: round $primary;
}

CardWidget.-moving,
ColumnView > ListItem.-highlight CardWidget.-moving,
ColumnView:focus > ListItem.-highlight CardWidget.-moving {
    border: dashed $warning;
    background: $warning 10%;
}

CardWidget.-dense {
    height: 3;
}

/* ── Sidebar ──────────────────────────────────────────────────────────── */

#sidebar {
    width: 36;
    height: 1fr;
    padding: 0 1;
    background: $surface;
    border-left: vkey $panel;
}

#sidebar.-collapsed {
    display: none;
}

#status-view, #log-view {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    border: round $panel;
    border-title-color: $text-muted;
}

/* ── Bottom bars ──────────────────────────────────────────────────────── */

/* Square corners that join, with the title sitting on the line, which is what
   the output panel above the command bar is drawn with too — the two are one
   overlay in two halves and wear the same border. */
#filter-bar, #command-bar {
    display: none;
    dock: bottom;
    /* Docked widgets stack against the edge rather than on each other, so the
       hint bar would otherwise sit on the closing edge of the box.  A row of
       margin puts it below one that now has corners to close. */
    margin: 0 0 1 0;
    border: solid $accent;
}

#filter-bar.-visible, #command-bar.-visible {
    display: block;
}

/* A filter still narrowing the board with the focus back on the cards.  The
   bar stays open showing the query in force, and the border says it is in
   force rather than being typed. */
#filter-bar.-active {
    border: solid $success;
    border-title-color: $success;
    color: $success;
}

/* The command bar shares the focus with the output panel, and the thick edge
   down the left is what says which of the two holds it.  It thickens in place:
   same cell, same centre line, so no character moves as the focus does.  The
   whole border is restated so a standing filter typed into again reads as a
   bar being typed into, whichever way the focus arrived. */
#filter-bar:focus, #command-bar:focus {
    border: solid $accent;
    border-left: thick $accent;
    color: $foreground;
}

/* A half-typed flag: the board holds still until the query parses again. */
#filter-bar.-unparsed {
    border: solid $error;
}

#filter-bar.-unparsed:focus {
    border-left: thick $error;
}

/* What a command printed, in the strip directly above the command bar, which
   stays open underneath it.  Docked widgets all sit against the edge rather
   than stacking, so the bottom margin — the height of the command bar — is what
   lifts this clear of it.  Tall enough to be worth reading, short enough to
   leave the board in view; longer output scrolls. */
#output-panel {
    display: none;
    dock: bottom;
    width: 1fr;
    height: auto;
    max-height: 16;
    /* Clear of the command bar and the hint row under it — see below. */
    margin: 0 0 4 0;
    padding: 0 1;
    background: $surface;
    border: solid $accent;
    border-title-color: $accent;
    overflow-x: auto;
    overflow-y: auto;
}

#output-panel.-visible {
    display: block;
}

/* The panel takes the thick left edge from the bar while shift+tab has the
   focus up here, and hands it back on the way down. */
#output-panel:focus {
    border-left: thick $accent;
}

/* Commands render at a fixed width; the body keeps that width rather than
   folding a table into a narrow terminal, and the panel scrolls to it. */
#output-panel-body {
    width: auto;
    min-width: 80;
    height: auto;
}

/* Stands in for the footer while a mode is active, so it wears the footer's
   own colours rather than looking like a different kind of bar. */
#mode-bar {
    display: none;
    dock: bottom;
    height: 1;
    padding: 0 1;
    color: $footer-foreground;
    background: $footer-background;
}

#mode-bar.-visible {
    display: block;
}

/* Completion candidates, which the bar colours itself rather than through
   markup: the muted colour carries an alpha that only CSS applies. */
#mode-bar.-muted {
    color: $text-muted;
}

.-empty {
    width: 1fr;
    height: auto;
    padding: 1 2;
    color: $text-muted;
    text-style: italic;
}

/* ── Modals ───────────────────────────────────────────────────────────── */

ModalScreen {
    align: center middle;
    background: $background 60%;
}

/* A dialog carries an `editor` layer for the field a screen lays over a row of
   an option list: the rows are drawn rather than mounted, so a field can cover
   one only from above.  See RowField. */
#dialog {
    layers: base editor;
    width: 78;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $surface;
    border: round $accent;
}

#dialog.-narrow {
    width: 52;
}

#form-heading {
    width: 1fr;
    margin: 0 0 1 0;
    text-style: bold;
    color: $accent;
}

#form-fields {
    height: auto;
    max-height: 24;
}

/* Markdown source, edited as text.  Fixed heights keep the form from growing
   past the dialog as the user types. */
#field-description {
    width: 1fr;
    height: 8;
    border: tall $panel;
}

#field-comment {
    width: 1fr;
    height: 5;
    border: tall $panel;
}

/* The comments already on the task, shown but not editable.  They read as they
   do in the task detail modal — markdown on the dialog's own background — so a
   comment looks the same wherever it is met, rather than like a filled field
   the user might try to type into.  No height cap and no scroll of its own
   either: they are shown in full and the form scrolls. */
#field-comments {
    width: 1fr;
    height: auto;
    padding: 0;
    margin: 0;
    background: transparent;
}

/* A comment's own heading, which Textual gives a document's spacing — two rows
   above it — where among the form's fields one row reads as the same break.
   Fenced code keeps Textual's own padding: the padded rows carry the fence's
   background, so they are what makes a code block look like a block. */
#field-comments MarkdownH2 {
    margin: 1 0 1 0;
}

#field-description:focus, #field-comment:focus {
    border: tall $accent;
}

/* The form's own field captions.  Direct children only: a descendant selector
   also catches the Label a markdown fence keeps its code in, which put a row
   above every code block and none below it. */
#form-fields > Label {
    margin: 1 0 0 0;
    color: $text-muted;
}

/* The Assigned to field and its suggestion dropdown. */

AutoCompleteInput {
    width: 1fr;
    height: auto;
}

AutoCompleteInput > OptionList.-suggestions {
    width: 1fr;
    height: auto;
    max-height: 8;
    margin: 0 2 0 2;
    padding: 0;
    background: $panel;
    border: none;
    border-left: outer $accent;
}

/* Keyboard focus stays in the text field while the dropdown is open, so the
   highlight has to be drawn as though the list itself were focused. */
AutoCompleteInput > OptionList.-suggestions > .option-list--option-highlighted {
    color: $block-cursor-foreground;
    background: $block-cursor-background;
    text-style: $block-cursor-text-style;
}

/* The values a field will take, under the field itself: said quietly, since it
   is a reminder rather than something to be read every time. */
#form-hint {
    height: auto;
    color: $text-muted;
}

#form-error {
    height: auto;
    margin: 1 0 0 0;
    color: $error;
}

#dialog-buttons {
    height: auto;
    margin: 1 0 0 0;
    align-horizontal: right;
}

#dialog-buttons Button {
    margin: 0 0 0 2;
}

/* The question names the dialog, so it takes the dialog's border colour. */
#confirm-prompt {
    height: auto;
    padding: 1 0;
    color: $accent;
}

/* The title and path naming the task a screen is acting on.  Weight carries
   the distinction rather than colour: the title is bold and the path is muted,
   the same way paths read elsewhere in the TUI. */

TaskHeading {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
}

TaskHeading .-task-title {
    width: 1fr;
    text-style: bold;
}

TaskHeading .-task-path {
    width: 1fr;
    color: $text-muted;
}

/* A task's metadata rows, shown wherever a screen describes one task. */
.-task-meta {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
}

#task-detail-body, #help-body {
    height: auto;
    max-height: 24;
}

/* Textual gives H1 and H2 two rows above them, where a body read in a modal
   this short wants the one row H3 and below already take. */
#task-detail-body MarkdownH1, #task-detail-body MarkdownH2 {
    margin: 1 0 1 0;
}

/* Stands under the Description heading of a task with nothing written in it,
   dimmed so it reads as an absence rather than as body text. */
#task-detail-empty {
    width: 1fr;
    height: auto;
    color: $text-muted;
    text-align: center;
}

#board-list {
    height: auto;
    max-height: 16;
    background: $surface;
}

#board-hint {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
}

/* A value edited on the row it belongs to.  The widget places itself over the
   highlighted row; compact already makes it one line with no border, so it
   occupies exactly the row it covers, and it is out of the layout entirely
   until it is opened. */
RowField {
    layer: editor;
    display: none;
    background: $boost;
}

RowField.-visible {
    display: block;
}

/* The columns a card can be moved to.  The subtitle carries whatever prefix
   is being typed, so the jump is visible rather than mysterious. */
#column-list {
    height: auto;
    max-height: 16;
    background: $surface;
    border: none;
    border-subtitle-align: right;
    border-subtitle-color: $accent;
}

/* A section heading in the configuration list.  Disabled is how the list marks
   a row that cannot be chosen, so it needs saying that this one is a heading
   rather than a setting that has been turned off. */
#config-list > .option-list--option-disabled {
    color: $primary;
    text-opacity: 100%;
}

/* The configuration keys, listed the same way, and the hints under them. */
#config-list {
    height: auto;
    max-height: 16;
    background: $surface;
    border: none;
    border-subtitle-align: right;
    border-subtitle-color: $accent;
}

/* What the setting in focus will take: said the way the value prompt says it,
   quietly and directly under what it belongs to.  It starts at the dialog's own
   left edge, with the heading and the list box, rather than at the rows' text.
   The row is held even when there is nothing to say, so the list and the
   buttons do not shift as the highlight passes a heading. */
#config-hint {
    width: 1fr;
    height: auto;
    min-height: 1;
    color: $text-muted;
}
